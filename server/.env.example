PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/Shaili
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=30d
NODE_ENV=development

CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_SECRET=your_cloudinary_secret

GEMINI_API_KEY=your_gemini_api_key
HF_TOKEN=your_huggingface_access_token

# Virtual Try-On (VTON) Provider Architecture Configuration
VTON_PRIMARY_PROVIDER=idm-vton
VTON_FALLBACK_PROVIDER=catvton
VTON_TIMEOUT=120000
VTON_MAX_RETRIES=2
VTON_COOLDOWN_PERIOD=180000
IDM_VTON_SPACE_ID=yisol/IDM-VTON
CATVTON_SPACE_ID=zhengchong/CatVTON

# Dedicated GPU Configuration (Optional)
# VTON_DEDICATED_GPU_URL=https://your-dedicated-gpu-endpoint.com/vton
# VTON_DEDICATED_GPU_API_KEY=your_dedicated_gpu_api_key
